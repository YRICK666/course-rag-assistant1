# Copy this file to .env and fill in the values you need.

# Optional. If empty, the system will only return retrieved snippets and a brief local summary.
DEEPSEEK_API_KEY=

# DeepSeek OpenAI-compatible chat completion endpoint.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Local embedding model. Chinese course materials usually work well with BGE Chinese embeddings.
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
